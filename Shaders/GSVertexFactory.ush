}

float3x3 VecToScaleMatrix(in float3 Scale)
{
    return float3x3(
		Scale.x, 0.0f, 0.0f,
		0.0f, Scale.y, 0.0f,
		0.0f, 0.0f, Scale.z
	);
}

float3 GetCameraUp(float3x3 ViewToTranslatedWorld)
{
	float3 CameraUp = float3(0.0f, 1.0f, 0.0f);
    CameraUp = mul(CameraUp, ViewToTranslatedWorld);
	CameraUp = normalize(CameraUp);
    return CameraUp;
}

float3 GetCameraRight(float3x3 ViewToTranslatedWorld)
{
	float3 CameraRight = float3(1.0f, 0.0f, 0.0f);
    CameraRight = mul(CameraRight, ViewToTranslatedWorld);
	CameraRight = normalize(CameraRight);
    
    return CameraRight;
}

float3 GetCameraForward(float3x3 ViewToTranslatedWorld)
{
    float3 CameraForward = float3(0.0f, 0.0f, 1.0f);
    CameraForward = mul(CameraForward, ViewToTranslatedWorld);
    CameraForward = normalize(CameraForward);
    
    return CameraForward;
}

/**
 * Projects splat into screen space based off of view provided
 */
void  
ComputeSplatParameters(
	// View properties
	in float4x4 TranslatedWorldToView,
    in float4x4 ViewToClip,
    in float4 ViewSizeAndInvSize,
    in float2 TanHalfFOV,
	in float4x4 ViewToTranslatedWorld, //camera matrix
	in FDFVector3 PreViewTranslation,
	in float4x4 TranslatedWorldToClip,

	// Primitive properties
	in FPrimitiveSceneData Primitive, 
	in uint SplatIndex,
	in float2 LocalPosition,

    out float4 OutWorldPosition,
	out float3 OutConic,
    out float3 OutWorldNormal
)
{
    float3x3 ScaleMatrix = VecToScaleMatrix(GSScl(SplatIndex));
    float3x3 RotationMatrix = mul(transpose(DFToFloat3x3(Primitive.LocalToWorld)), QuatToMatrix(GSRot(SplatIndex)));
    float3 MeanPosition = GSPos(SplatIndex);

	// Calculate covariance matrix
    float3x3 T = mul(RotationMatrix, ScaleMatrix);
    float3x3 Covariance3D = mul(T, transpose(T));

    if (IsOrthoProjection(ViewToClip))
    {
        //100 uuscale
        //128 size of smallest VSM page
        float3x3 OrthoProjectionMatrix = float3x3(
        float3(100.f / 128.f, 0,0),
        float3(0, 100.f / 128.f,0),
        float3(0,0, 100.f)
		);


        float3x3 JW = mul(OrthoProjectionMatrix, transpose((float3x3) TranslatedWorldToView));
        float3x3 covView = mul(JW, mul(transpose(Covariance3D), transpose(JW)));

        float X = covView[0][0]         ;
        float Y = covView[1][1]         ;
        float Covariance = covView[0][1];

		// Determine conic for the splat
        float Determinant = X * Y - Covariance * Covariance;
        float3 Conic = float3(X, Covariance, Y) / Determinant; 

        float Mid = (X + Y);
        float Delta = length(float2((X - Y), (2 * Covariance)));
			
        float Lambda1 = 0.5f * (Mid + Delta);
        float Lambda2 = 0.5f * (Mid - Delta);

        float4 worldOffset = float4(0, 0, 0, 1);

        OutWorldPosition = float4(0, 0, 0, 0);

        if (Lambda2 > 0.0f)
        {
            float2 DiagonalVector = normalize(float2((Covariance - Y + Lambda1), (-X + Covariance + Lambda1)));
            float2 MajorAxis = 3 * sqrt(Lambda1) * DiagonalVector;
            float2 MinorAxis = 3 * sqrt(Lambda2) * float2(DiagonalVector.y, -DiagonalVector.x);

			//LocalPosition is Corners of a quad (-1,1)
            worldOffset.xyz = LocalPosition.x * float3(MajorAxis,0) + LocalPosition.y * float3(MinorAxis, 0);
        };

        worldOffset *= 100.f;

        float3x3 CamM = (float3x3) ViewToTranslatedWorld;
        worldOffset.xyz = mul(worldOffset.xyz,CamM);

        float4 TranslatedMeanPosition = TransformLocalToTranslatedWorld(MeanPosition, Primitive.LocalToWorld);

        OutWorldPosition = float4(TranslatedMeanPosition.xyz + worldOffset.xyz, 1);

        OutConic = Conic;
        OutWorldNormal = RotateLocalToWorld(GSResources.Normals[SplatIndex], Primitive.LocalToWorld, Primitive.InvNonUniformScale);
    }
	else
    {
          float3x3 covView;
          float SplatZScale = 1.f;

		  float3 TranslatedWorldPositionNaniteView = TransformLocalToTranslatedWorld(MeanPosition, Primitive.LocalToWorld).xyz;
          TranslatedWorldPositionNaniteView += DFFastSubtractDemote(PreViewTranslation, ResolvedView.PreViewTranslation);

       
		  float4 ViewPosition = mul(float4(TranslatedWorldPositionNaniteView, 1), TranslatedWorldToView);

       	  ViewPosition.xyz *= 0.01f;

		  SplatZScale = ViewPosition.z / (ViewPosition.w);


       	  // Calculate Jacobian matrix based off of projection matrix
       	  // // Perspective jacobian calculation based off of https://jtstephens18.github.io/posts/Building-a-Gaussian-Splatting-Renderer-In-OpenGL/
          float FocalZ = ViewSizeAndInvSize.y / (2.f * TanHalfFOV.y);
          float LimX = 1.3f * TanHalfFOV.x;
          float LimY = 1.3f * TanHalfFOV.y;

          float TxTz = ViewPosition.x / ViewPosition.z;
          float TyTz = ViewPosition.y / ViewPosition.z;

		  //// Clamped versions of TxTz and TyTz 
		  float Tx = min(LimX, max(-LimX, TxTz)) * ViewPosition.z;
		  float TY = min(LimY, max(-LimY, TyTz)) * ViewPosition.z;

          float3x3 J = float3x3(
	      FocalZ / ViewPosition.z, 0.0f, -(FocalZ * Tx) / (ViewPosition.z * ViewPosition.z),
	      0.0f, FocalZ / ViewPosition.z, -(FocalZ * TY) / (ViewPosition.z * ViewPosition.z),
	      0.0f, 0.0f, 0.0f
	      );

          float3x3 JW = mul(J, transpose((float3x3) TranslatedWorldToView));
          covView = mul(JW, mul(transpose(Covariance3D), transpose(JW)));
          
			
		  {
              float X = covView[0][0];
          	  float Y = covView[1][1];
              float Covariance = covView[0][1];

			  // Determine conic for the splat
              float Determinant = X * Y - Covariance * Covariance;
              float3 Conic = float3(X, Covariance, Y) / Determinant;

              float Mid = (X + Y);
              float Delta = length(float2((X - Y), (2 * Covariance)));
	
              float Lambda1 = 0.5f * (Mid + Delta);
              float Lambda2 = 0.5f * (Mid - Delta);

              float4 worldOffset = float4(0, 0, 0, 1);

              OutWorldPosition = float4(0, 0, 0, 0);

              OutConic = float3(0, 0, 0);
              OutWorldNormal = float3(0, 0, 0);

              if (Lambda2 > 0.0f)
              {
                 float2 DiagonalVector = normalize(float2((Covariance - Y + Lambda1), (-X + Covariance + Lambda1))) * SplatZScale * max(TanHalfFOV.x, TanHalfFOV.y);
                 float2 MajorAxis = 3 * sqrt(Lambda1) * DiagonalVector;
                 float2 MinorAxis = 3 * sqrt(Lambda2) * float2(DiagonalVector.y, -DiagonalVector.x);

              	 //LocalPosition is Corners of a quad (-1,1)
              	 worldOffset.xyz = LocalPosition.x * float3(MajorAxis, 0) + LocalPosition.y * float3(MinorAxis, 0);
              };

          	float3x3 CamM = (float3x3) ViewToTranslatedWorld;
			//View Space is Local Space
          	worldOffset.xyz = mul(worldOffset.xyz, CamM);
            worldOffset /= worldOffset.w;

            OutWorldPosition = float4(TranslatedWorldPositionNaniteView + worldOffset.xyz - DFFastSubtractDemote(PreViewTranslation, ResolvedView.PreViewTranslation), 1);
            OutConic = Conic;
            OutWorldNormal = RotateLocalToWorld(GSResources.Normals[SplatIndex], Primitive.LocalToWorld, Primitive.InvNonUniformScale);
		}
    }
}

/** Attributes to interpolate from the vertex shader to the pixel shader. */
struct FVertexFactoryInterpolantsVSToPS
{
    nointerpolation float3 Conic : CONIC;
    float  Opacity : OPACITY;

#if NUM_TEX_COORD_INTERPOLATORS
	float4 TexCoords[(NUM_TEX_COORD_INTERPOLATORS + 1) / 2] : TEXCOORD0;
#endif
};

#if VIRTUAL_SM_ENABLED
void TransformToVirtualSmPage(inout float4 PointClip, inout float4 ClipPlanesInOut, FPageInfo PageInfo, float3 PointTranslatedWorld);
#endif

/** Compute the intermediates for a given vertex. */
FVertexFactoryIntermediates GetVertexFactoryIntermediates(FVertexFactoryInput Input)
{
    FVertexFactoryIntermediates Intermediates;
    Intermediates.SceneData = VF_GPUSCENE_GET_INTERMEDIATES(Input);

	static float2 Quad[6] =
	{
		float2(-1, -1),
		float2(-1, 1),
		float2(1, -1),
		float2(1, -1),
		float2(-1, 1),
    	float2(1, 1)
	};

	uint Index = Input.VertexId / 6;
	if (Index >= GSPrimitiveResources.SplatIndexCountBuffer[0])
	{
		FVertexFactoryIntermediates DummyIntermediates = (FVertexFactoryIntermediates)0;
		return DummyIntermediates;
	}
	uint SplatIndex = GSPrimitiveResources.SplatIndexBuffer[Input.VertexId / 6];

    Intermediates.LocalPos = float4(Quad[Input.VertexId % 6], 0, 1);

    //cull very non opaque splats
    // athenea: a medium's gaussians (an optical depth, not an opacity) cast
    // no opaque shadow; their shadow on the scene is athenea-research's
    // proposal 108, not done.
    if (GSShOp(SplatIndex).w < 0.9 || GSResources.VolumeOn != 0u)
    {
        Intermediates.WorldPosition = float4(0, 0, 0, 0);
        Intermediates.Conic = float3(0, 0, 0);
        Intermediates.Opacity = 0;

        return Intermediates;
    }

    Intermediates.Opacity = GSShOp(SplatIndex).w;

#if SHADOW_DEPTH_SHADER
	uint PackedPageInfo = InstanceCulling_PageInfoBuffer[Intermediates.SceneData.InstanceIdLoadIndex];
	FPageInfo PageInfo = UnpackPageInfo(PackedPageInfo);
	FNaniteView NaniteView = UnpackNaniteView(ShadowDepthPass_PackedNaniteViews[PageInfo.ViewId]);
#endif

    ComputeSplatParameters(
		// View parameters
#if SHADOW_DEPTH_SHADER
		NaniteView.TranslatedWorldToView,
		NaniteView.ViewToClip,
		float4(128, 128, 1.f/128.f, 1.f/128.f), // VSM page is 128 pixels squared, its size is fixed in WS
		float2(1.0f / NaniteView.ViewToClip[0][0], 1.0f / NaniteView.ViewToClip[1][1]),
		NaniteView.ViewToTranslatedWorld,
		NaniteView.PreViewTranslation,
		NaniteView.TranslatedWorldToClip,
#else
        ResolvedView.TranslatedWorldToView,
        ResolvedView.ViewToClip,
        ResolvedView.ViewSizeAndInvSize,
        ResolvedView.TanAndInvTanHalfFOV.xy,
		ResolvedView.ViewToTranslatedWorld,
		ResolvedView.PreViewTranslation,
		ResolvedView.TranslatedWorldToClip,
#endif
        // Primitive parameters
		Intermediates.SceneData.Primitive,
        SplatIndex,
        Intermediates.LocalPos.xy * 0.5,
        // Outputs
        Intermediates.WorldPosition,
        Intermediates.Conic,
        Intermediates.Normal
	);

    return Intermediates;
}

// RHI_RAYTRACING
#if COMPUTESHADER || RAYHITGROUPSHADER
FVertexFactoryInput LoadVertexFactoryInputForHGS(uint TriangleIndex, int VertexIndex)
{
	// For 4 verts cutout geometry and normal particle geometry, use the typical 6 indices
	FVertexFactoryInput Input;
	
	uint IndexBuffer[6] = { 0, 2, 3, 0, 1, 2 };
	uint VertexId = IndexBuffer[(TriangleIndex * 3 + VertexIndex) % 6];
	
	Input.VertexId = VertexId;
	Input.InstanceId = TriangleIndex / 2;
	
	return Input;
}

FVertexFactoryInput LoadVertexFactoryInputForDynamicUpdate(uint TriangleIndex, int VertexIndex, uint PrimitiveId, uint DrawInstanceId)
{
	return LoadVertexFactoryInputForHGS(TriangleIndex, VertexIndex);
}
uint GetNumRayTracingDynamicMeshVerticesIndirect()
{
	const uint NumVertices = 6;
	const uint NumInstances = 1; //GSResources.SplatCount;
	return NumVertices * NumInstances;
}
#endif

float3 VertexFactoryGetPreviousInstanceSpacePosition(FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates);
float3 VertexFactoryGetInstanceSpacePosition(FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates);

/** Converts from vertex factory specific input to a FMaterialVertexParameters, which is used by vertex shader material inputs. */
FMaterialVertexParameters GetMaterialVertexParameters(
	FVertexFactoryInput Input,
	FVertexFactoryIntermediates Intermediates,
	float3 WorldPosition,
	half3x3 TangentToLocal,
	bool bIsPreviousFrame = false)
{
    FMaterialVertexParameters Result = MakeInitializedMaterialVertexParameters();

    Result.SceneData = Intermediates.SceneData;
	
    Result.WorldPosition = WorldPosition;
    if (bIsPreviousFrame)
    {
        Result.PositionInstanceSpace = VertexFactoryGetPreviousInstanceSpacePosition(Input, Intermediates);
    }
    else
    {
        Result.PositionInstanceSpace = VertexFactoryGetInstanceSpacePosition(Input, Intermediates);
    }
    Result.PositionPrimitiveSpace = Result.PositionInstanceSpace; // No support for instancing, so instance == primitive

    Result.TangentToWorld = TangentToLocal; //Local is world, particles are generated in WS

    Result.PreSkinnedPosition = WorldPosition; 
    Result.PreSkinnedNormal = float3(0, 0, 1);


#if NUM_MATERIAL_TEXCOORDS_VERTEX
	UNROLL
	for (int CoordinateIndex = 0; CoordinateIndex < NUM_MATERIAL_TEXCOORDS_VERTEX; CoordinateIndex++)
	{
		Result.TexCoords[CoordinateIndex] = Intermediates.LocalPos.xy * 0.5f + 0.5f;
	}
#endif  //NUM_MATERIAL_TEXCOORDS_VERTEX

    Result.LWCData = MakeMaterialLWCData(Result);

    return Result;
}

