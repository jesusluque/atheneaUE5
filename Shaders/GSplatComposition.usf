#include "/Engine/Private/Common.ush"
#include "/Engine/Private/ScreenPass.ush"

#include "/Engine/Private/DeferredShadingCommon.ush"


#if SUBSTRATE_ENABLED

#define SUBSTRATE_MATERIALCONTAINER_IS_VIEWRESOURCE 1
#define MATERIAL_SUBSTRATE_OPAQUE_PRECOMPUTED_LIGHTING 0
#define SUBSTRATE_OPAQUE_DEFERRED 1
#define SUBSTRATE_DEFERRED_SHADING 1

#include "/Engine/Private/Substrate/Substrate.ush"
#include "/Engine/Private/Substrate/SubstrateExport.ush"
#include "/Engine/Private/Substrate/SubstrateLegacyConversion.ush"

#define SUBSTRATE_OUTPUT_GBUFFER  (SUBSTRATE_OPAQUE_DEFERRED && SUBSTRATE_GBUFFER_FORMAT==1)

// These are left in as canaries for future breaking engine changes that will stop this method from working
#if SUBSTRATE_OUTPUT_GBUFFER
#if SUBSTRATE_BASE_PASS_MRT_OUTPUT_COUNT != 3
#error Substrate SUBSTRATE_BASE_PASS_MRT_OUTPUT_COUNT has been updated but not the uint MRTs
#endif
#if SUBSTRATE_FIRST_MRT_INDEX > 4
#error Substrate cannot map to such a case
#endif
#endif

// Default functions for Legacy material conversion to function properly
void GetEyeNormals(float IrisMask, float IrisDistance, in float3 InNormal, in float3 InClearCoatNormal, in float3 InCustomTangent, inout float3 OutIrisNormal, inout float3 OutIrisPlaneNormal)
{
	OutIrisNormal = InNormal;
	OutIrisPlaneNormal = InNormal;
}

// Default functions for PackSubstrateOut to function properly
void FSubstratePixelHeader::PreUpdateAllBSDFWithBottomUpOperatorVisit(float3 V) {}
void FSubstratePixelHeader::UpdateAllBSDFsOperatorCoverageTransmittance(FSubstrateIntegrationSettings Settings, float3 V) {}
void FSubstratePixelHeader::UpdateAllOperatorsCoverageTransmittance() {}
void FSubstratePixelHeader::UpdateAllBSDFWithBottomUpOperatorVisit() {}
void FSubstratePixelHeader::PreUpdateAllBSDFWithBottomUpOperatorVisit_FullySimplified(float3 V) {}
void FSubstratePixelHeader::UpdateAllBSDFsOperatorCoverageTransmittance_FullySimplified(FSubstrateIntegrationSettings Settings, float3 V) {}
void FSubstratePixelHeader::UpdateAllOperatorsCoverageTransmittance_FullySimplified() {}
void FSubstratePixelHeader::UpdateAllBSDFWithBottomUpOperatorVisit_FullySimplified() {}

// Substrate parameters
uint MaxBytesPerPixel;
uint MaxClosurePerPixel;
uint bRoughDiffuse;
uint PeelLayersAboveDepth;
uint bRoughnessTracking;
uint bStochasticLighting;

int SliceStoringDebugSubstrateTreeDataWithoutMRT;
int FirstSliceStoringSubstrateSSSDataWithoutMRT;
RWTexture2DArray<uint> MaterialTextureArrayUAVWithoutRTs;
RWTexture2D<float3> OpaqueRoughRefractionTextureUAV;

#endif

SCREEN_PASS_TEXTURE_VIEWPORT(InputViewPort)
SCREEN_PASS_TEXTURE_VIEWPORT(OutputViewPort)

// Splat-buffer Textures
Texture2D<float4> GSplatBaseColor;
Texture2D<float4> GSplatNormal;
Texture2D<float4> GSplatDepthMetallicRoughness;
Texture2D<float4> GSplatVelocity;

float AlphaThreshold;

RWTexture2D<float4> RWVelocityTexture;


void GSplatCompositionPS(
	float2 InUV : TEXCOORD0,
	float4 SvPosition : SV_Position

#if PIXELSHADEROUTPUT_MRT0
	, out float4 OutTarget0 : SV_Target0
#endif

#if PIXELSHADEROUTPUT_MRT1
	, out float4 OutTarget1 : SV_Target1
#endif

#if PIXELSHADEROUTPUT_MRT2
	, out float4 OutTarget2 : SV_Target2
#endif

#if PIXELSHADEROUTPUT_MRT3
	, out float4 OutTarget3 : SV_Target3
#endif

//--- SUBSTRATE ---
#if SUBSTRATE_OUTPUT_GBUFFER
#if SUBSTRATE_FIRST_MRT_INDEX == 4
		, out uint SubstrateOutput4 : SV_Target4
		, out uint SubstrateOutput5 : SV_Target5
		, out uint SubstrateOutput6 : SV_Target6
		, out SUBSTRATE_TOP_LAYER_TYPE SubstrateOutput7 : SV_Target7
#elif SUBSTRATE_FIRST_MRT_INDEX == 3
		, out uint SubstrateOutput3 : SV_Target3
		, out uint SubstrateOutput4 : SV_Target4
		, out uint SubstrateOutput5 : SV_Target5
		, out SUBSTRATE_TOP_LAYER_TYPE SubstrateOutput6 : SV_Target6
#elif SUBSTRATE_FIRST_MRT_INDEX == 2
		, out uint SubstrateOutput2 : SV_Target2
		, out uint SubstrateOutput3 : SV_Target3
		, out uint SubstrateOutput4 : SV_Target4
		, out SUBSTRATE_TOP_LAYER_TYPE SubstrateOutput5 : SV_Target5
#else
		, out uint SubstrateOutput1 : SV_Target1
		, out uint SubstrateOutput2 : SV_Target2
		, out uint SubstrateOutput3 : SV_Target3
		, out SUBSTRATE_TOP_LAYER_TYPE SubstrateOutput4 : SV_Target4
#endif
#else // SUBSTRATE_OUTPUT_GBUFFER

#if PIXELSHADEROUTPUT_MRT4
	, out float4 OutTarget4 : SV_Target4
#endif

#if PIXELSHADEROUTPUT_MRT5
	, out float4 OutTarget5 : SV_Target5
#endif

#if PIXELSHADEROUTPUT_MRT6
	, out float4 OutTarget6 : SV_Target6
#endif

#if PIXELSHADEROUTPUT_MRT7
	, out float4 OutTarget7 : SV_Target7
#endif

#endif // SUBSTRATE_OUTPUT_GBUFFER

	, out float OutDepth : SV_Depth
)
{
	float4 BaseColor = GSplatBaseColor.Sample(View.SharedBilinearClampedSampler, InUV).rgba;
	if (BaseColor.a < AlphaThreshold)
	{
		discard;
	}

	// athenea: each target holds its values premultiplied by every splat's
	// alpha and their sum in alpha: divided by it, a pixel two splats half
	// cover reads their mean, not half of it (upstream's defect).
	const float4 DMR = GSplatDepthMetallicRoughness.Sample(View.SharedBilinearClampedSampler, InUV);
	const float4 Moved = GSplatVelocity.Sample(View.SharedBilinearClampedSampler, InUV);
	BaseColor.rgb /= max(BaseColor.a, 1.0e-6f);
	const float3 WorldSpaceNormal = normalize(GSplatNormal.Sample(View.SharedBilinearClampedSampler, InUV).rgb);
	const float3 DepthMetallicRoughness = DMR.rgb / max(DMR.a, 1.0e-6f);
	const float3 ScreenSpaceVelocity = Moved.rgb / max(Moved.a, 1.0e-6f);

	const float DeviceZ = DepthMetallicRoughness.r;
	const float Metallic = DepthMetallicRoughness.g;
	const float Roughness = DepthMetallicRoughness.b;
	const float Specular = 0.5f;

	float4 TranslatedWorldPosition = mul(float4(SvPosition.xy, DeviceZ, 1), View.SVPositionToTranslatedWorld);
	TranslatedWorldPosition.xyz /= TranslatedWorldPosition.w;
	float3 CameraVector = -GetCameraVectorFromTranslatedWorldPosition(TranslatedWorldPosition.xyz);

	FPixelShaderOut PSOut;

#if (MATERIAL_IS_SUBSTRATE && SUBSTRATE_ENABLED && SUBSTRATE_GBUFFER_FORMAT == 1)

	// Create Substrate slab from GBuffer data
	FSubstratePixelHeader SubstratePixelHeader = InitialiseSubstratePixelHeader();
	const FSubstratePixelFootprint PixelFootprint = SubstrateGetPixelFootprint(TranslatedWorldPosition.xyz, 0.0f);

	FSubstrateData SubstrateData = SubstratePixelHeader.SubstrateTree.PromoteParameterBlendedBSDFToOperator(
		SubstrateConvertLegacyMaterialStatic(
			PixelFootprint,
			BaseColor.rgb,
			Specular,
			Metallic,
			Roughness,
			0.0f, // Aniso
			float3(1.0f, 1.0f, 1.0f), // Subsurface colour
			0, // Subsurface profile int
			1.0f, // Clear coat
			0.1f, // Clear coat roughness
			float3(0.0f, 0.0f, 0.0f), // Emissive
			1.0f, // Opacity
			float3(0.5f, 0.5f, 0.5f), // Thin translucent colour
			1.0f, // Thin translucent coverage
			float3(0.0f, 0.0f, 0.0f), // Water scattering
			float3(0.0f, 0.0f, 0.0f), // Water absorption
			0.0f, // Water phase G
			float3(1.0f, 1.0f, 1.0f), // Color scale behind water
			SHADINGMODELID_DEFAULT_LIT, // Shading model
			WorldSpaceNormal, // Raw normal
			WorldSpaceNormal, // Raw tangent
			WorldSpaceNormal, // Raw clear coat normal
			WorldSpaceNormal, // Raw custom tangent
			0, // Shared local basis index
			0, // Clear coat bottom normal shared local basis index
			SubstratePixelHeader.SharedLocalBases.Types
		), /*int OperatorIndex*/ 0, /*int BSDFIndex*/ 0, /*int LayerDepth*/ 0, /*int bIsBottom*/ 1
	);
	SubstratePixelHeader.SubstrateTree.BSDFs[0].LuminanceWeightV = 1.0f;
	SubstratePixelHeader.SubstrateTree.BSDFs[0].TransmittanceAboveAlongN = 1.0f;
	SubstratePixelHeader.SubstrateTree.BSDFs[0].TopLayerDataWeight = 1.0f;

	SubstratePixelHeader.SharedLocalBases.Normals[0] =  WorldSpaceNormal;
	SubstratePixelHeader.SharedLocalBases.Count = 1;

	SubstratePixelHeader.ClosureCount = SubstratePixelHeader.SubstrateTree.BSDFCount;
	SubstratePixelHeader.IrradianceAO = InitIrradianceAndOcclusion();

	// Generate the Substrate material data to write out
	FSubstrateIntegrationSettings Settings = InitSubstrateIntegrationSettings(
		false /*bForceFullyRough*/, 
		bRoughDiffuse, 
		PeelLayersAboveDepth, 
		bRoughnessTracking
	);

	// Output substrate data to adaptive GBuffer

	FSubstrateAddressing SubstrateAddressing = GetSubstratePixelDataByteOffset(SvPosition.xy, uint2(PrimaryView.BufferSizeAndInvSize.xy), MaxBytesPerPixel);
	FRWSubstrateMaterialContainer RWSubstrateMaterialContainer = InitialiseRWSubstrateMaterialContainer(MaterialTextureArrayUAVWithoutRTs, 1, SvPosition.xy);

	const float Dither = 0.0f;

	// inout params
	bool bSubstrateSubsurfaceEnabled = false;
	float3 EmissiveLuminance = 0.0f;
	FSubstrateSubsurfaceData SSSData = (FSubstrateSubsurfaceData)0;
	FSubstrateTopLayerData TopLayerData = (FSubstrateTopLayerData)0;
	FSubstrateOpaqueRoughRefractionData OpaqueRoughRefractionData = (FSubstrateOpaqueRoughRefractionData)0;

	PackSubstrateOut(
		RWSubstrateMaterialContainer,
		MaterialTextureArrayUAVWithoutRTs,
		Dither,
		Settings,
		SubstrateAddressing,

		// GBuffer data built into a Substrate slab
		SubstratePixelHeader, 
		SubstrateData, 
		
		CameraVector,
		WorldSpaceNormal,
		bSubstrateSubsurfaceEnabled,
		EmissiveLuminance,
		SSSData,
		TopLayerData,
		OpaqueRoughRefractionData
	);

	PSOut.SubstrateOutput[0] = RWSubstrateMaterialContainer.MaterialRenderTargets[0];
	PSOut.SubstrateOutput[1] = RWSubstrateMaterialContainer.MaterialRenderTargets[1];
	PSOut.SubstrateOutput[2] = RWSubstrateMaterialContainer.MaterialRenderTargets[2];
	PSOut.SubstrateTopLayerData = SubstratePackTopLayerData(TopLayerData);

#else

	// Legacy GBuffer & Substrate blendable GBuffer method

	// Encode into GBuffer data
	FGBufferData GBufferData = (FGBufferData) 0;
	GBufferData.Depth = DeviceZ;
	GBufferData.WorldNormal = WorldSpaceNormal;
	GBufferData.DiffuseColor = BaseColor.rgb;
	GBufferData.SpecularColor = 0.0f;
	GBufferData.BaseColor = BaseColor.rgb;
	GBufferData.Metallic = Metallic;
	GBufferData.Specular = Specular;
	GBufferData.Roughness = Roughness;
	GBufferData.ShadingModelID = SHADINGMODELID_DEFAULT_LIT;
	GBufferData.Velocity = 0.0f;
	GBufferData.GenericAO = 1.0f;

	// Encode data into MRT format
	EncodeGBufferToMRT(PSOut, GBufferData, /* QuantizationBias = */0.0f);

#endif

	OutDepth = DeviceZ;
	RWVelocityTexture[SvPosition.xy] = EncodeVelocityToTexture(ScreenSpaceVelocity);

	PSOut.MRT[0] = float4(0, 0, 0, 0);

#if PIXELSHADEROUTPUT_MRT0
	OutTarget0 = PSOut.MRT[0];
#endif

#if PIXELSHADEROUTPUT_MRT1
	OutTarget1 = PSOut.MRT[1];
#endif

#if PIXELSHADEROUTPUT_MRT2
	OutTarget2 = PSOut.MRT[2];
#endif

#if PIXELSHADEROUTPUT_MRT3
	OutTarget3 = PSOut.MRT[3];
#endif

#if SUBSTRATE_OUTPUT_GBUFFER
#if SUBSTRATE_FIRST_MRT_INDEX == 4
	SubstrateOutput4 = PSOut.SubstrateOutput[0];
	SubstrateOutput5 = PSOut.SubstrateOutput[1];
	SubstrateOutput6 = PSOut.SubstrateOutput[2];
	SubstrateOutput7 = PSOut.SubstrateTopLayerData;
#elif SUBSTRATE_FIRST_MRT_INDEX == 3
	SubstrateOutput3 = PSOut.SubstrateOutput[0];
	SubstrateOutput4 = PSOut.SubstrateOutput[1];
	SubstrateOutput5 = PSOut.SubstrateOutput[2];
	SubstrateOutput6 = PSOut.SubstrateTopLayerData;
#elif SUBSTRATE_FIRST_MRT_INDEX == 2
	SubstrateOutput2 = PSOut.SubstrateOutput[0];
	SubstrateOutput3 = PSOut.SubstrateOutput[1];
	SubstrateOutput4 = PSOut.SubstrateOutput[2];
	SubstrateOutput5 = PSOut.SubstrateTopLayerData;
#else
	SubstrateOutput1 = PSOut.SubstrateOutput[0];
	SubstrateOutput2 = PSOut.SubstrateOutput[1];
	SubstrateOutput3 = PSOut.SubstrateOutput[2];
	SubstrateOutput4 = PSOut.SubstrateTopLayerData;
#endif
#else // SUBSTRATE_OUTPUT_GBUFFER

#if PIXELSHADEROUTPUT_MRT4
	OutTarget4 = PSOut.MRT[4];
#endif

#if PIXELSHADEROUTPUT_MRT5
	OutTarget5 = PSOut.MRT[5];
#endif

#if PIXELSHADEROUTPUT_MRT6
	OutTarget6 = PSOut.MRT[6];
#endif

#if PIXELSHADEROUTPUT_MRT7
	OutTarget7 = PSOut.MRT[7];
#endif

#endif // SUBSTRATE_OUTPUT_GBUFFER
}
