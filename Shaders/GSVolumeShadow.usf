// Copyright (c) 2026 jesus luque.
//
// A MEDIUM'S SHADOW ON ITSELF (a ParticleField marked athenea:splat:volume):
// the light that reaches each gaussian's centre through the rest of the
// medium, every frame, for the colour GSCompute.usf gives it.
//
//   GSVolumeDepositCS  each gaussian's extinction, densityScale sigma G(x),
//                      added into a 64^3 grid over the primitive's local
//                      bounds (fixed point, atomics), out to 3 deviations
//                      and at most 9 samples an axis (a wider gaussian is
//                      sampled with a stride and weighed by its cube);
//   GSVolumeShadowCS   from each centre, the optical depth through the grid
//                      towards UE's directional light and towards five
//                      directions of the sky above (the upper hemisphere's
//                      zenith and four at 45 degrees), as transmittances.
//
// athenea reads its cloud shadow map at the centre; this grid is the same
// question asked of a coarser medium. Lengths are local centimetres; the
// extinction is per unit of the file's length (FileUnitsToCm centimetres).

#include "/Engine/Private/Common.ush"
#include "/Engine/Private/Quaternion.ush"
#include "/Engine/Generated/GeneratedUniformBuffers.ush"

#define GS_GRID 64u
#define GS_FIXED 4096.0f

RWStructuredBuffer<uint> Grid;
StructuredBuffer<uint> GridIn;
RWStructuredBuffer<float2> OutShadow;
// A world direction in the primitive's local axes, unit.
float3 GSToLocal(float3 World)
{
	return normalize(mul(World, (float3x3) Primitive.RelativeWorldToLocal));
}

float3 GridLo() { return Primitive.LocalObjectBoundsMin; }
float3 GridSize() { return max(Primitive.LocalObjectBoundsMax - Primitive.LocalObjectBoundsMin, 1.0e-3f); }

[numthreads(64, 1, 1)]
void GSVolumeDepositCS(uint3 Id : SV_DispatchThreadID)
{
	const uint i = Id.x;
	if (i >= GSResources.SplatCount || GSResources.VolumeOn == 0u)
	{
		return;
	}
	const float3 P = GSResources.Positions[i];
	const float3 S = max(GSResources.Scales[i] * 100.0f, 1.0e-3f);
	const float3x3 R = QuatToMatrix(GSResources.Orientations[i]);
	const float Sigma = GSResources.VolumeDensityScale * GSResources.Volume[i].x;
	if (!(Sigma > 0.0f))
	{
		return;
	}
	const float3 Voxel = GridSize() / float(GS_GRID);
	const float Reach = 3.0f * max(S.x, max(S.y, S.z));
	const int3 Lo = clamp(int3(floor((P - Reach - GridLo()) / Voxel)), 0, int(GS_GRID) - 1);
	const int3 Hi = clamp(int3(floor((P + Reach - GridLo()) / Voxel)), 0, int(GS_GRID) - 1);
	const int3 Span = Hi - Lo + 1;
	const int Stride = max(1, int(ceil(float(max(Span.x, max(Span.y, Span.z))) / 9.0f)));
	const float Weight = float(Stride * Stride * Stride);
	for (int z = Lo.z; z <= Hi.z; z += Stride)
	for (int y = Lo.y; y <= Hi.y; y += Stride)
	for (int x = Lo.x; x <= Hi.x; x += Stride)
	{
		const float3 C = GridLo() + (float3(x, y, z) + 0.5f) * Voxel;
		const float3 U = mul(C - P, R) / S;
		const float D2 = dot(U, U);
		if (D2 < 9.0f)
		{
			const uint Add = uint(Sigma * exp(-0.5f * D2) * Weight * GS_FIXED + 0.5f);
			if (Add > 0u)
			{
				InterlockedAdd(Grid[(uint(z) * GS_GRID + uint(y)) * GS_GRID + uint(x)], Add);
			}
		}
	}
}

float GSOpticalDepth(float3 From, float3 Dir)
{
	const float3 Voxel = GridSize() / float(GS_GRID);
	const float Step = min(Voxel.x, min(Voxel.y, Voxel.z));
	const float ToFile = 1.0f / max(GSResources.FileUnitsToCm, 1.0e-6f);
	float Tau = 0.0f;
	float3 X = From + Dir * (0.5f * Step);
	for (uint s = 0; s < 128u; ++s)
	{
		const float3 G = (X - GridLo()) / Voxel;
		if (any(G < 0.0f) || any(G >= float(GS_GRID)))
		{
			break;
		}
		const uint3 V = uint3(G);
		Tau += float(GridIn[(V.z * GS_GRID + V.y) * GS_GRID + V.x]) * (Step * ToFile / GS_FIXED);
		X += Dir * Step;
	}
	return Tau;
}

[numthreads(64, 1, 1)]
void GSVolumeShadowCS(uint3 Id : SV_DispatchThreadID)
{
	const uint i = Id.x;
	if (i >= GSResources.SplatCount)
	{
		return;
	}
	if (GSResources.VolumeOn == 0u)
	{
		OutShadow[i] = float2(1.0f, 1.0f);
		return;
	}
	const float3 P = GSResources.Positions[i];
	// UE's directional light (View.DirectionalLightDirection points at it).
	const bool bLight = any(View.DirectionalLightColor.rgb > 0.0f);
	const float Sun = bLight ? exp(-GSOpticalDepth(P, GSToLocal(View.DirectionalLightDirection.xyz))) : 1.0f;
	// The sky above: the zenith and four directions at 45 degrees round it.
	const float3 Up = GSToLocal(float3(0.0f, 0.0f, 1.0f));
	const float3 A = normalize(abs(Up.z) < 0.9f ? cross(Up, float3(0, 0, 1)) : cross(Up, float3(1, 0, 0)));
	const float3 B = cross(Up, A);
	float Sky = exp(-GSOpticalDepth(P, Up));
	Sky += exp(-GSOpticalDepth(P, normalize(Up + A)));
	Sky += exp(-GSOpticalDepth(P, normalize(Up - A)));
	Sky += exp(-GSOpticalDepth(P, normalize(Up + B)));
	Sky += exp(-GSOpticalDepth(P, normalize(Up - B)));
	OutShadow[i] = float2(Sun, Sky * 0.2f);
}
