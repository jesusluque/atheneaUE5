#include "/Engine/Private/Common.ush"
#include "/Engine/Private/ComputeShaderUtils.ush"
#include "/Engine/Private/Quaternion.ush"

#include "Shared/GaussiansDefinitions.h"


#ifndef THREADGROUP_SIZE_1D
#define THREADGROUP_SIZE_1D 1
#endif


RWBuffer<uint> RWSplatIndexBufferAllocator;
RWBuffer<uint> RWSplatIndices;

uint NumClippingVolumes;
StructuredBuffer<FGaussians_ClippingVolume> ClippingVolumes;

float SplatScaleMultiplier;


struct FOrientedBoundingBox
{
	float3 Origin;
	float3 HalfExtents;
	float3x3 Axes;
};

// OBB intersection test helpers
float OBBProjectionRadius(FOrientedBoundingBox Box, float3 L)
{
	return abs(dot(L, Box.Axes[0])) * Box.HalfExtents.x +
           abs(dot(L, Box.Axes[1])) * Box.HalfExtents.y +
           abs(dot(L, Box.Axes[2])) * Box.HalfExtents.z;
}

bool OBBsSeparatedOnAxis(float3 L, FOrientedBoundingBox A, FOrientedBoundingBox B)
{
	float CenterDist = abs(dot(L, B.Origin - A.Origin));
	float ProjRadius = OBBProjectionRadius(A, L) + OBBProjectionRadius(B, L);
	return CenterDist > ProjRadius;
}

bool OBBsOverlap(FOrientedBoundingBox A, FOrientedBoundingBox B)
{
    // 3 axes of A
	if (OBBsSeparatedOnAxis(A.Axes[0], A, B))
		return false;
	if (OBBsSeparatedOnAxis(A.Axes[1], A, B))
		return false;
	if (OBBsSeparatedOnAxis(A.Axes[2], A, B))
		return false;

    // 3 axes of B
	if (OBBsSeparatedOnAxis(B.Axes[0], A, B))
		return false;
	if (OBBsSeparatedOnAxis(B.Axes[1], A, B))
		return false;
	if (OBBsSeparatedOnAxis(B.Axes[2], A, B))
		return false;
		
    // 9 cross-product axes (skip near-degenerate pairs of parallel axes)
	const float kMinLenSq = 1e-8f;
    [unroll]
	for (int i = 0; i < 3; ++i)
	{
        [unroll]
		for (int j = 0; j < 3; ++j)
		{
			float3 L = cross(A.Axes[i], B.Axes[j]);
			float LenSq = dot(L, L);
			if (LenSq > kMinLenSq)
			{
				L *= rsqrt(LenSq);
				if (OBBsSeparatedOnAxis(L, A, B))
					return false;
			}
		}
	}

	return true;
}

bool OBBContainsOBB(FOrientedBoundingBox Outer, FOrientedBoundingBox Inner)
{
	float3 D = Inner.Origin - Outer.Origin;

	if (abs(dot(D, Outer.Axes[0])) + OBBProjectionRadius(Inner, Outer.Axes[0]) > Outer.HalfExtents.x)
		return false;
	if (abs(dot(D, Outer.Axes[1])) + OBBProjectionRadius(Inner, Outer.Axes[1]) > Outer.HalfExtents.y)
		return false;
	if (abs(dot(D, Outer.Axes[2])) + OBBProjectionRadius(Inner, Outer.Axes[2]) > Outer.HalfExtents.z)
		return false;

	return true;
}

// 0 -> no intersection
// 1 -> partial intersection
// 2 -> A is completely enveloped by B
int OBBvsOBBIntersectionTest(FOrientedBoundingBox A, FOrientedBoundingBox B)
{
	if (OBBContainsOBB(B, A))
		return 2; // check containment first (implies overlap)
	if (!OBBsOverlap(A, B))
		return 0;
	return 1;
}

//   0 -> sphere and OBB do not intersect
//   1 -> partial intersection
//   2 -> OBB is wholly contained by the sphere
int SphereOBBIntersection(float3 SphereCenter, float SphereRadius, FOrientedBoundingBox OBB)
{
	float3 D = SphereCenter - OBB.Origin;
	float3 L;
	L.x = dot(D, OBB.Axes[0]);
	L.y = dot(D, OBB.Axes[1]);
	L.z = dot(D, OBB.Axes[2]);

	float3 A = abs(L);
	float rSq = SphereRadius * SphereRadius;

	float3 Far = A + OBB.HalfExtents;
	if (dot(Far, Far) <= rSq)
		return 2;

	float3 Diff = max(A - OBB.HalfExtents, 0.0);
	if (dot(Diff, Diff) > rSq)
		return 0;

	return 1;
}


[numthreads(THREADGROUP_SIZE_1D, 1, 1)]
void GSplatCullingCS(uint3 GroupId : SV_GroupID, uint GroupIndex : SV_GroupIndex)
{
	uint SplatIndex = GetUnWrappedDispatchThreadId(GroupId, GroupIndex, THREADGROUP_SIZE_1D);

	// If there are no clipping volumes, all splats are visible
	bool bVisible = NumClippingVolumes == 0;

	if (SplatIndex < GSResources.SplatCount && NumClippingVolumes > 0)
	{
		float3 LocalPosition = GSResources.Positions[SplatIndex];
		float4 TranslatedWorldPosition = DFTransformLocalToTranslatedWorld(LocalPosition, MakeDFMatrix4x3(Primitive.PositionHigh, Primitive.LocalToRelativeWorld), MakeDFVector3(0, 0));

		FOrientedBoundingBox SplatOBB;
		SplatOBB.Origin = TranslatedWorldPosition.xyz;
		SplatOBB.Axes = mul((float3x3) Primitive.RelativeWorldToLocal, QuatToMatrix(GSResources.Orientations[SplatIndex]));
		// 3 standard deviations of the gaussian included to capture 99.7% of volume
		// Factor of 100 to convert to Unreal units
		SplatOBB.HalfExtents = 300.0f * GSResources.Scales[SplatIndex] * Primitive.NonUniformScale.xyz * Primitive.NonUniformScale.xyz * SplatScaleMultiplier;

		bVisible = true;

		for (uint i = 0; i < NumClippingVolumes; i++)
		{
			FGaussians_ClippingVolume ClippingVolume = ClippingVolumes[i];

			FOrientedBoundingBox ClippingVolumeOBB;
			ClippingVolumeOBB.Origin = ClippingVolume.Origin;
			ClippingVolumeOBB.Axes = float3x3(ClippingVolume.AxisX_HalfExtentX.xyz, ClippingVolume.AxisY_HalfExtentY.xyz, ClippingVolume.AxisZ_HalfExtentZ.xyz);
			ClippingVolumeOBB.HalfExtents = float3(ClippingVolume.AxisX_HalfExtentX.w, ClippingVolume.AxisY_HalfExtentY.w, ClippingVolume.AxisZ_HalfExtentZ.w);

			int Intersection = (ClippingVolume.GetShape() == GAUSSIANS_CLIPPING_SHAPE_BOX)
				? OBBvsOBBIntersectionTest(SplatOBB, ClippingVolumeOBB)
				: SphereOBBIntersection(ClippingVolumeOBB.Origin, ClippingVolumeOBB.HalfExtents.x, SplatOBB);

			switch (ClippingVolume.GetMode())
			{
				case GAUSSIANS_CLIPPING_MODE_CLIP_INSIDE_ALL:
					bVisible = bVisible && (Intersection < 2); // Visible if splat is not entirely inside volume
					break;
				case GAUSSIANS_CLIPPING_MODE_CLIP_INSIDE_ANY:
					bVisible = bVisible && (Intersection == 0); // Visible if splat does not intersect volume at all
					break;
				case GAUSSIANS_CLIPPING_MODE_CLIP_OUTSIDE_ALL:
					bVisible = bVisible && (Intersection > 0); // Visible if splat intersects in any way
					break;
				case GAUSSIANS_CLIPPING_MODE_CLIP_OUTSIDE_ANY:
					bVisible = bVisible && (Intersection == 2); // Visible only if splat is completely contained
					break;
				default:
					break;
			}

			if (!bVisible)
			{
				break;
			} 
		}
	}

	if (bVisible)
	{
		// Splat was not culled and its index should be written to the index buffer
		// We can guarantee that the allocated index buffer will have sufficient capacity so no need to bounds check
		uint OutIndex;
		InterlockedAdd(RWSplatIndexBufferAllocator[0], 1, OutIndex);
		RWSplatIndices[OutIndex] = SplatIndex;
	}
}
