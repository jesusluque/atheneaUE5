#include "/Engine/Private/Common.ush"
#include "/Engine/Private/Quaternion.ush"
#include "/Engine/Private/OctahedralCommon.ush"
#include "/Engine/Private/ComputeShaderUtils.ush"
#include "/Engine/Private/VelocityCommon.ush"

#include "/Engine/Generated/GeneratedUniformBuffers.ush"

// For frustum & occlusion culling
#include "/Engine/Private/Nanite/NaniteHZBCull.ush"

#include "Shared/GaussiansDefinitions.h"
#include "GSColor.ush"

#ifndef ENABLE_RELIGHTING
#define ENABLE_RELIGHTING true
#endif


// Check isnan(value) before use.
uint order_preserving_float_map(float value)
{
    // For negative values, the mask becomes 0xffffffff.
    // For positive values, the mask becomes 0x80000000.
    uint uvalue = asuint(value);
    uint mask = -int(uvalue >> 31) | 0x80000000;
    return uvalue ^ mask;
}

float inverse_order_preserving_float_map(uint value)
{
    // If the msb is set, the mask becomes 0x80000000.
    // If the msb is unset, the mask becomes 0xffffffff.
    uint mask = ((value >> 31) - 1) | 0x80000000;
    return asfloat(value ^ mask);
}


uint PackNormal(float3 Normal)
{
	float2 OctahedronDirection = UnitVectorToOctahedron(Normal);
	return (f32tof16(OctahedronDirection.x) << 16) | f32tof16(OctahedronDirection.y);
}

float3 UnpackNormal(uint PackedNormal)
{
	return OctahedronToUnitVector(float2(f16tof32(PackedNormal >> 16), f16tof32(PackedNormal)));
}

uint PackMetallicRoughness(float2 MetallicRoughness)
{
	return (f32tof16(saturate(MetallicRoughness.x)) << 16) | f32tof16(saturate(MetallicRoughness.y));
}

float2 UnpackMetallicRoughness(uint PackedMR)
{
	return float2(f16tof32(PackedMR >> 16), f16tof32(PackedMR));
}

uint2 PackVelocity(float3 Velocity)
{
	return uint2(
		PackNormal(normalize(Velocity)),
		asuint(length(Velocity))
	);
}

float3 UnpackVelocity(uint2 PackedVelocity)
{
	return UnpackNormal(PackedVelocity.x) * asfloat(PackedVelocity.y);
}

Buffer<uint> SplatIndexBuffer;
Buffer<uint> SplatIndexCounter;

RWBuffer<uint> Counter;

RWBuffer<float2> OutSSPositions;
RWBuffer<float4> OutSSScale;
RWStructuredBuffer<float3> OutConic;
RWBuffer<float4> OutColorOpacity;
// athenea: a TX splat's sharp lobes, for the raster to read per pixel (GSColor.ush).
RWBuffer<uint4> OutSharpA;
RWBuffer<uint4> OutSharpB;
uint SharpOut;    // 0: the frame keeps none; 1: this cloud's are made; 2: written as none

#if ENABLE_RELIGHTING
RWBuffer<uint> OutNormal; // Octahedron encoding 16bpc
RWBuffer<uint> OutMetallicRoughness;
RWBuffer<uint2> OutSSVelocity;
#endif

RWBuffer<uint> OutDepth;
RWBuffer<uint> OutGaussianIDX;

// Capacity of buffers holding gaussian properties
uint BufferCapacity;

float SplatScaleMultiplier;
float SplatOpacityThreshold;


// athenea: A BLACK BODY'S LIGHT at `Kelvin` (athenea's volume_blackbody.slang):
// Planck's law against the CIE 1931 functions (Wyman, Sloan and Shirley's
// fit), to linear Rec.709 at luminance one, times sigma_SB T^4 / pi * 1e-6 as
// Cycles' Principled Volume scales it.
float GSLobe(float x, float Mean, float Left, float Right)
{
	const float t = (x - Mean) / (x < Mean ? Left : Right);
	return exp(-0.5f * t * t);
}

float3 GSBlackbody(float Kelvin)
{
	if (Kelvin < 300.0f)
	{
		return 0.0f;
	}
	float3 XYZ = 0.0f;
	for (uint s = 0; s <= 94u; ++s)
	{
		const float Nm = 360.0f + 5.0f * float(s);
		const float E = 1.4387769e7f / (Nm * Kelvin);
		if (E > 80.0f)
		{
			continue;
		}
		const float R = Nm / 500.0f;
		const float Planck = 1.0f / (R * R * R * R * R * (exp(E) - 1.0f));
		XYZ += Planck * float3(
			1.056f * GSLobe(Nm, 599.8f, 37.9f, 31.0f) + 0.362f * GSLobe(Nm, 442.0f, 16.0f, 26.7f) - 0.065f * GSLobe(Nm, 501.1f, 20.4f, 26.2f),
			0.821f * GSLobe(Nm, 568.8f, 46.9f, 40.5f) + 0.286f * GSLobe(Nm, 530.9f, 16.3f, 31.1f),
			1.217f * GSLobe(Nm, 437.0f, 11.8f, 36.0f) + 0.681f * GSLobe(Nm, 459.0f, 26.0f, 13.8f));
	}
	const float3 Rgb = max(float3(dot(float3(3.2404542f, -1.5371385f, -0.4985314f), XYZ),
		dot(float3(-0.9692660f, 1.8760108f, 0.0415560f), XYZ),
		dot(float3(0.0556434f, -0.2040259f, 1.0572252f), XYZ)), 0.0f);
	const float Luminance = dot(float3(0.2126f, 0.7152f, 0.0722f), Rgb);
	if (!(Luminance > 0.0f))
	{
		return 0.0f;
	}
	const float T2 = Kelvin * Kelvin * 1.0e-6f;
	return Rgb / Luminance * (5.670374e-8f / 3.14159265f * T2 * T2 * 1.0e6f);
}

float3x3 VecToScaleMatrix(in float3 Scale)
{
	return float3x3(
		Scale.x, 0.0f, 0.0f,
		0.0f, Scale.y, 0.0f,
		0.0f, 0.0f, Scale.z
	);
}

// Mixed Rendering Pipeline
// 1. GSPrepass
// 2. Sort by view depth
// 3. SplatRasterization (VS+PS) - Renders each splat as a billboard, writing out the depth and color of each splat to the GBuffer

#ifndef THREADGROUP_SIZE_1D
#define THREADGROUP_SIZE_1D 1
#endif

// athenea: a medium's transmittance to UE's directional light and to the sky,
// a pair a gaussian (GSVolumeShadow.usf); one pair of zeros for other clouds.
StructuredBuffer<float2> VolumeShadow;

groupshared uint GS_NumSplats;
groupshared uint GS_OutBufferStartIndex;

groupshared float2 GS_SSPositions[THREADGROUP_SIZE_1D];
groupshared float4 GS_SSScale[THREADGROUP_SIZE_1D];
groupshared float3 GS_Conic[THREADGROUP_SIZE_1D];
groupshared float4 GS_ColorOpacity[THREADGROUP_SIZE_1D];
groupshared uint4 GS_SharpA[THREADGROUP_SIZE_1D];
groupshared uint4 GS_SharpB[THREADGROUP_SIZE_1D];

#if ENABLE_RELIGHTING
groupshared uint GS_Normal[THREADGROUP_SIZE_1D];
groupshared uint GS_MetallicRoughness[THREADGROUP_SIZE_1D];
groupshared uint2 GS_SSVelocity[THREADGROUP_SIZE_1D];
#endif

groupshared uint GS_Depth[THREADGROUP_SIZE_1D];


[numthreads(THREADGROUP_SIZE_1D, 1, 1)]
void GSPrepass(uint3 DispatchThreadId : SV_DispatchThreadID, uint3 GroupId : SV_GroupID, uint GroupIndex : SV_GroupIndex)
{
	if (DispatchThreadId.x == 0)
	{
		Counter[0] = 4; // 4 vertices for a quad in a triangle strip
	}

	uint SplatIndex = (uint)-1;
	if (DispatchThreadId.x < SplatIndexCounter[0])
	{
		SplatIndex = SplatIndexBuffer[DispatchThreadId.x];
	}

	if (GroupIndex == 0)
	{
		GS_NumSplats = 0;
	}

	GroupMemoryBarrierWithGroupSync();

	//Terminate if we are outside the bounds of our input data
	if (SplatIndex < GSResources.SplatCount && GSResources.SHAndOpacities[SplatIndex].a > SplatOpacityThreshold)
    {
	    float3 LocalPosition = GSResources.Positions[SplatIndex];
	    float4 TranslatedWorldPosition = DFTransformLocalToTranslatedWorld(LocalPosition, MakeDFMatrix4x3(Primitive.PositionHigh, Primitive.LocalToRelativeWorld), PrimaryView.PreViewTranslation);
		float4 PrevTranslatedWorldPosition = DFTransformLocalToTranslatedWorld(LocalPosition, MakeDFMatrix4x3(Primitive.PositionHigh, Primitive.PreviousLocalToRelativeWorld), PrimaryView.PrevPreViewTranslation);

		float3x3 ScaleMatrix = VecToScaleMatrix(GSResources.Scales[SplatIndex] * Primitive.NonUniformScale.xyz * Primitive.NonUniformScale.xyz * SplatScaleMultiplier);
		float3x3 RotationMatrix = mul((float3x3) Primitive.RelativeWorldToLocal, QuatToMatrix(GSResources.Orientations[SplatIndex]));

		// Calculate covariance matrix
		float3x3 T = mul(RotationMatrix, ScaleMatrix);
		float3x3 Covariance3D = mul(T, transpose(T));

		// Power iteration to find the largest eigenvalue
		float3 v = float3(1.0f, 0.0f, 0.0f);
		float MajorEigenvalue = 0.0f;

		UNROLL
    	for (int i = 0; i < 4; ++i)
		{
			v = mul(v, Covariance3D);
			float v_length = length(v);
			if (v_length > 1e-6)
			{
				v = v / v_length;

				MajorEigenvalue = v_length;
			}
		}

		// Compute a safe box extent for frustum culling (original 3DGS paper used same radius):
		// = 3.0f * sqrt(major_variance)
		// Factor of 100 converts back to Unreal units
		float3 WorldSpaceExtent = 300.0f * sqrt(MajorEigenvalue);

		bool bVisible = true;

		// Frustum cull individual splats
		FFrustumCullData FrustumCullData = BoxCullFrustum(
			TranslatedWorldPosition.xyz,
			WorldSpaceExtent,
			PrimaryView.TranslatedWorldToClip,
			PrimaryView.ViewToClip,
			false,
			true,
			false
		);
		bVisible = bVisible && (FrustumCullData.bIsVisible);

		if (bVisible)
		{
			// Fixes all the maths...
			TranslatedWorldPosition.xyz *= 0.01f;

			float4 ViewPosition = mul(TranslatedWorldPosition, PrimaryView.TranslatedWorldToView);
			float4 ClipPosition = mul(ViewPosition, PrimaryView.ViewToClip);
			ClipPosition /= ClipPosition.w;

		    // Calculate Jacobian matrix based off of projection matrix
			// Jacobian calculation based off of https://jtstephens18.github.io/posts/Building-a-Gaussian-Splatting-Renderer-In-OpenGL/
			float FocalZ = PrimaryView.ViewSizeAndInvSize.y / (2.0f * PrimaryView.TanAndInvTanHalfFOV.y);

			float LimX = 1.3f * PrimaryView.TanAndInvTanHalfFOV.x;
			float LimY = 1.3f * PrimaryView.TanAndInvTanHalfFOV.y;

			float TxTz = ViewPosition.x / ViewPosition.z;
			float TyTz = ViewPosition.y / ViewPosition.z;

			// Clamped versions of TxTz and TyTz 
			float Tx = min(LimX, max(-LimX, TxTz)) * ViewPosition.z;
			float TY = min(LimY, max(-LimY, TyTz)) * ViewPosition.z;

			float3x3 J = float3x3(
		        FocalZ / ViewPosition.z,    0.0f,                       -(FocalZ * Tx) / (ViewPosition.z * ViewPosition.z),
		        0.0f,                       FocalZ / ViewPosition.z,    -(FocalZ * TY) / (ViewPosition.z * ViewPosition.z),
				0.0f,                       0.0f,                       0.0f
			);

			float3x3 JW = mul(J, transpose((float3x3) PrimaryView.TranslatedWorldToView));
			float3x3 Covariance2D = mul(JW, mul(transpose(Covariance3D), transpose(JW)));

			// athenea: a SURFEL (a scale of zero, as every merged group of a
			// .athc's levels is a flat disc) pays the third of a pixel of dilation
			// back by area, as athenea's splat_project does (surfelPaid): its
			// disc's area over the area drawn, the union of the disc and a round
			// half pixel squared. Edge on, the disc has no area and is not drawn;
			// without this it came out an opaque line, and a far cut's merges a
			// lattice of them. A gaussian with three scales is drawn as before.
			float SurfelPaid = 1.0f;
			{
				const float3 S = GSResources.Scales[SplatIndex];
				if (min(min(S.x, S.y), S.z) == 0.0f)
				{
					const float A0 = Covariance2D[0][0], C0 = Covariance2D[1][1], B0 = Covariance2D[0][1];
					const float Half = 0.5f * (A0 + C0);
					const float Split = sqrt(max(0.25f * (A0 - C0) * (A0 - C0) + B0 * B0, 0.0f));
					const float L1 = max(Half + Split, 0.0f), L2 = max(Half - Split, 0.0f);
					const float Disc = sqrt(L1 * L2);
					const float Drawn = Disc + 0.5f - sqrt(min(L1, 0.5f) * min(L2, 0.5f));
					SurfelPaid = Drawn > 1.0e-12f ? min(Disc / Drawn, 1.0f) : 1.0f;
				}
			}

            float X = Covariance2D[0][0] + 0.3f;
            float Y = Covariance2D[1][1] + 0.3f;
			float Covariance = Covariance2D[0][1];

		    // Determine conic for the splat
			float Determinant = X * Y - Covariance * Covariance;
			float3 Conic = float3(Y, Covariance, X) / Determinant;

		    // Finally calculate the bounds of a screenspace quad that will be rasterized for this splat
			float Mid = (X + Y);
			float Delta = length(float2((X - Y), (2 * Covariance)));
			
		    float Lambda1 = 0.5f * (Mid + Delta);
		    float Lambda2 = 0.5f * (Mid - Delta);

		    if (Lambda2 > 0.0f)
		    {
				float2 DiagonalVector = normalize(float2((Covariance - Y + Lambda1), (-X + Covariance + Lambda1)));
				// athenea: the harder kernel's flat top reaches past three sigmas;
				// its quad is widened by 0.7 (D - 1) sigma, as Spark and athenea's
				// falloffCutoff widen the cut (D held to 5).
				const float Hard = GSResources.SHAndOpacities[SplatIndex].a;
				const float Sigmas = GSResources.VolumeOn != 0u ? 3.5f
					: Hard > 1.0f ? 3.0f + 0.7f * (min(Hard, 5.0f) - 1.0f) : 3.0f;
				float2 MajorAxis = min(Sigmas * sqrt(Lambda1), 1024.0f) * DiagonalVector;
				float2 MinorAxis = min(Sigmas * sqrt(Lambda2), 1024.0f) * float2(DiagonalVector.y, -DiagonalVector.x);
				
				float2 MajorAxisMultiplier = MajorAxis / (PrimaryView.ViewSizeAndInvSize.xy * 0.5f);
				float2 MinorAxisMultiplier = MinorAxis / (PrimaryView.ViewSizeAndInvSize.xy * 0.5f);

				// More precise culling: check if screen space quad is on-screen
				float2 Max = ClipPosition.xy + (abs(MinorAxisMultiplier) + abs(MajorAxisMultiplier));
				float2 Min = ClipPosition.xy - (abs(MinorAxisMultiplier) + abs(MajorAxisMultiplier));

				bVisible = all(and(Min < 1.0f, Max.x > -1.0f));

				// Cull against HZB
				if (bVisible)
				{
					// Multiply by 100 again to convert to Unreal units
					float Depth = ConvertToDeviceZ(100.0f * ViewPosition.z);
					FScreenRect ScreenRect = GetScreenRect(int4(0, 0, HZBViewSize), float3(Min, Depth), float3(Max, Depth), 4);
					bVisible = bVisible && (IsVisibleHZB(ScreenRect, true));
				}

		    	if (bVisible)
				{
					// Write splat properties to groupshared memory
					uint Index;
					InterlockedAdd(GS_NumSplats, 1, Index);

					GS_SSPositions[Index] = ClipPosition.xy;
					GS_SSScale[Index] = float4(MajorAxisMultiplier, MinorAxisMultiplier);
					GS_Conic[Index] = Conic;
	        
					// athenea: the eye sits at the translated world's origin, so the
					// splat's translated position is the view direction; the colour
					// takes its harmonics along it unless the splat is relit, where
					// the colour is an albedo.
					const float3 LocalView = mul(TranslatedWorldPosition.xyz, (float3x3) Primitive.RelativeWorldToLocal);

					// athenea: how a TX surface's normal turns a pixel right and a
					// pixel down, from its shape operator (athenea's splat_project):
					// the splat's own first two axes are the file's mapped through
					// the rotation (FileAxisX, FileAxisY); a pixel's step on the
					// splat's plane in metres, then in the file's units; the turn
					// along those axes, in the file's frame.
					GSSharpOn = false;
					if (SharpOut == 1u && GSResources.HasCurvature != 0u && (GSResources.ColorFlags & GS_COLOR_TRANSFER) != 0u)
					{
						const float3x3 LocalAxes = QuatToMatrix(GSResources.Orientations[SplatIndex]);
						const float3 uL = mul(LocalAxes, GSResources.FileAxisX);
						const float3 vL = mul(LocalAxes, GSResources.FileAxisY);
						const float3 uF = float3(dot(uL, GSResources.FileAxisX), dot(uL, GSResources.FileAxisY), dot(uL, GSResources.FileAxisZ));
						const float3 vF = float3(dot(vL, GSResources.FileAxisX), dot(vL, GSResources.FileAxisY), dot(vL, GSResources.FileAxisZ));
						const float3 uW = normalize(mul(RotationMatrix, GSResources.FileAxisX));
						const float3 vW = normalize(mul(RotationMatrix, GSResources.FileAxisY));
						// Pixels a metre along each: x right, y down (the view's y is up).
						const float3 Tx = JW[0];
						const float3 Ty = -JW[1];
						const float2x2 ToPixels = float2x2(dot(Tx, uW), dot(Tx, vW), dot(Ty, uW), dot(Ty, vW));
						const float Det = ToPixels[0][0] * ToPixels[1][1] - ToPixels[0][1] * ToPixels[1][0];
						if (abs(Det) > 1.0e-12f)
						{
							// File units a metre of the world: the actor's scale and the file's units.
							const float FileUnits = 100.0f / max(GSResources.FileUnitsToCm * Primitive.NonUniformScale.x, 1.0e-6f);
							const float2 StepX = float2(ToPixels[1][1], -ToPixels[1][0]) / Det * FileUnits;
							const float2 StepY = float2(-ToPixels[0][1], ToPixels[0][0]) / Det * FileUnits;
							const uint c = SplatIndex * 3u;
							const float2x2 Shape = float2x2(GSResources.TransferCurvature[c], GSResources.TransferCurvature[c + 1u],
								GSResources.TransferCurvature[c + 1u], GSResources.TransferCurvature[c + 2u]);
							const float2 TurnX = mul(Shape, StepX);
							const float2 TurnY = mul(Shape, StepY);
							const float3 dX = uF * TurnX.x + vF * TurnX.y;
							const float3 dY = uF * TurnY.x + vF * TurnY.y;
							// A step the plane barely holds (a splat seen edge on) turns it at most this far.
							const float Most = 0.5f;
							GSSharpTurnX = dX * min(1.0f, Most / max(length(dX), 1.0e-9f));
							GSSharpTurnY = dY * min(1.0f, Most / max(length(dY), 1.0e-9f));
							GSSharpTurn2 = dot(dX, dX) + dot(dY, dY);
							GSSharpOn = true;
						}
					}
					GS_ColorOpacity[Index] = GSSplatColor(SplatIndex, LocalView, !ENABLE_RELIGHTING);
					GS_ColorOpacity[Index].a *= SurfelPaid;
					if (GSResources.VolumeOn != 0u)
					{
						// athenea: A MEDIUM'S GAUSSIAN (athenea's splat_volume): its
						// optical depth along the ray through its centre, densityScale
						// sigma sqrt(2 pi) / sqrt(r' Sigma^-1 r) in the file's units, which
						// the pixel shader takes down by the image gaussian and draws as
						// 1 - exp(-tau). Carried as a negative opacity.
						const float3 Ray = normalize(TranslatedWorldPosition.xyz);
						const float3x3 C = Covariance3D;
						const float3 C0 = cross(C[1], C[2]), C1 = cross(C[2], C[0]), C2 = cross(C[0], C[1]);
						const float Det = dot(C[0], C0);
						// Sigma^-1 r by the cofactors (Sigma symmetric).
						const float3 InvRay = float3(dot(C0, Ray), dot(C1, Ray), dot(C2, Ray)) / Det;
						const float Quad = max(dot(Ray, InvRay), 1.0e-12f);
						const float2 Medium = GSResources.Volume[SplatIndex];
						const float ToFile = 100.0f / max(GSResources.FileUnitsToCm, 1.0e-6f);
						const float Tau = GSResources.VolumeDensityScale * Medium.x * 2.50662827f / sqrt(Quad) * ToFile;
						// Its radiance: what it scatters of UE's directional light and
						// of the sky (the projected sky's mean and its sun), each through
						// the medium's shadow on itself (GSVolumeShadow.usf), and what its
						// absorbing part glows with. The phase is isotropic; multiple
						// scattering is athenea's octaves (Wrenninge): energy and
						// extinction halved at each, four of them.
						const float2 Lit = VolumeShadow[SplatIndex];
						float2 Octaves = 0.0f;
						UNROLL
						for (uint o = 0; o < 4u; ++o)
						{
							const float a = exp2(-float(o));
							Octaves += a * float2(pow(max(Lit.x, 1.0e-6f), a), pow(max(Lit.y, 1.0e-6f), a));
						}
						const float3 Albedo = saturate(GS_ColorOpacity[Index].rgb * GSResources.VolumeAlbedo);
						const float3 Sun = View.DirectionalLightColor.rgb * 3.14159265f * (1.0f / (4.0f * 3.14159265f));
						const float3 Scattered = Sun * Octaves.x
							+ (SkySH[0].rgb * 0.28209479f + SkySH[17].rgb * (1.0f / (4.0f * 3.14159265f))) * Octaves.y;
						float3 Glow = GSResources.VolumeEmission;
						if (GSResources.VolumeEmissionScale > 0.0f && Medium.y > 0.0f)
						{
							Glow += GSResources.VolumeEmissionScale * GSBlackbody(GSResources.VolumeTemperatureOffset + GSResources.VolumeTemperatureScale * Medium.y);
						}
						GS_ColorOpacity[Index] = float4(max(Albedo * Scattered + (1.0f - Albedo) * Glow, 0.0f), -Tau);
					}
					GS_SharpA[Index] = GSSharpOn ? GSSharpA : uint4(0, 0, 0, 0);
					GS_SharpB[Index] = GSSharpOn ? GSSharpB : uint4(0, 0, 0, 0);

					GS_Depth[Index] = order_preserving_float_map(ViewPosition.z);

#if ENABLE_RELIGHTING
					float3 WorldSpaceNormal = mul((float3x3) Primitive.RelativeWorldToLocal, GSResources.Normals[SplatIndex]);
					GS_Normal[Index] = PackNormal(WorldSpaceNormal);
					GS_MetallicRoughness[Index] = PackMetallicRoughness(GSResources.MetallicRoughness[SplatIndex]);

					// Calculate screenspace velocity
					float4 CurrentClipPosition = mul(float4(TranslatedWorldPosition.xyz * 100.0f, 1.0f), PrimaryView.TranslatedWorldToClip);
					CurrentClipPosition /= CurrentClipPosition.w;
					CurrentClipPosition.xy -= PrimaryView.TemporalAAJitter.xy;

					float4 PreviousClipPosition = mul(PrevTranslatedWorldPosition, PrimaryView.PrevTranslatedWorldToClip);
					PreviousClipPosition /= PreviousClipPosition.w;
					PreviousClipPosition.xy -= PrimaryView.TemporalAAJitter.zw;

					float3 Velocity = float3(CurrentClipPosition.xyz - PreviousClipPosition.xyz);

					GS_SSVelocity[Index] = PackVelocity(Velocity);
#endif
				}
			}
		}
    }

	GroupMemoryBarrierWithGroupSync();

    // Output properties of screenspace quad and projected gaussians

	// Allocate space in global buffer
	if (GroupIndex == 0 && GS_NumSplats > 0)
	{
		InterlockedAdd(Counter[1], GS_NumSplats, GS_OutBufferStartIndex);
		if (GS_OutBufferStartIndex >= BufferCapacity)
		{
			uint Dummy;
			InterlockedExchange(Counter[1], BufferCapacity, Dummy);

			GS_NumSplats = 0;
		}
		else if (GS_OutBufferStartIndex + GS_NumSplats > BufferCapacity)
		{
			// athenea: the group that straddles the end keeps what fits, so no
			// write lands past the buffer (DX12 drops those, Metal and Vulkan do not).
			uint Dummy;
			InterlockedExchange(Counter[1], BufferCapacity, Dummy);

			GS_NumSplats = BufferCapacity - GS_OutBufferStartIndex;
		}
	}

	GroupMemoryBarrierWithGroupSync();

	if (GroupIndex < GS_NumSplats)
	{
		uint Idx = GS_OutBufferStartIndex + GroupIndex;

		OutSSPositions[Idx] = GS_SSPositions[GroupIndex];
		OutSSScale[Idx] = GS_SSScale[GroupIndex];
		OutConic[Idx] = GS_Conic[GroupIndex];
        
		OutGaussianIDX[Idx] = Idx;
		OutColorOpacity[Idx] = GS_ColorOpacity[GroupIndex];
		if (SharpOut != 0u)
		{
			OutSharpA[Idx] = GS_SharpA[GroupIndex];
			OutSharpB[Idx] = GS_SharpB[GroupIndex];
		}

		OutDepth[Idx] = GS_Depth[GroupIndex];

#if ENABLE_RELIGHTING
		OutNormal[Idx] = GS_Normal[GroupIndex];
		OutMetallicRoughness[Idx] = GS_MetallicRoughness[GroupIndex];
		OutSSVelocity[Idx] = GS_SSVelocity[GroupIndex];
#endif
	}
}

Buffer<float2> VS_SSPositions;
Buffer<float4> VS_SSScale;
StructuredBuffer<float3> VS_Conic;

Buffer<float4> VS_ColorOpacity;

Buffer<uint> VS_Depth;

#if ENABLE_RELIGHTING
Buffer<uint> VS_MetallicRoughness;
Buffer<uint> VS_Normal; // Octahedron encoding 16bpc
Buffer<uint2> VS_SSVelocity;
#endif

Buffer<uint> VS_GaussianIDX;

// athenea: the sharp lobes the prepass handed over, and what the pixel shader
// reads them with: the residual sky (GSColor.ush's SkyResidual) and the sun in
// the world, (direction, half angle) and (irradiance).
Buffer<uint4> VS_SharpA;
Buffer<uint4> VS_SharpB;
uint SharpIn;
StructuredBuffer<float4> SunWorld;

struct FOutVertex
{
	float4 Position : SV_POSITION;
	float2 Mean : MEAN;

    float3 Color : COLOR;
	float3 Conic : CONIC;
    float Opacity : OPACITY;

	float DeviceZ : DEPTH;

	nointerpolation uint4 SharpA : SHARPA;
	nointerpolation uint4 SharpB : SHARPB;

#if ENABLE_RELIGHTING
    float2 MR : METALLICROUGHNESS;
    float3 Normal : NORMAL_MEAN;
	float3 Velocity : VELOCITY_MEAN;
#else
	// For velocity calculation
	float3 TranslatedWorldPosition : WORLDPOS;
#endif
};


static float2 Quad[4] =
{
	float2(-1, -1),
	float2(-1, 1),
	float2(1, -1),
	float2(1, 1)
};

FOutVertex GSSplatting_VS(uint GlobalVertexId : SV_VertexID, uint InstanceID : SV_InstanceID )
{
    uint Index = VS_GaussianIDX[InstanceID];

    FOutVertex Output;

    Output.Color = VS_ColorOpacity[Index].rgb;
    Output.Opacity = VS_ColorOpacity[Index].a;
	Output.SharpA = SharpIn != 0u ? VS_SharpA[Index] : uint4(0, 0, 0, 0);
	Output.SharpB = SharpIn != 0u ? VS_SharpB[Index] : uint4(0, 0, 0, 0);

    float3 Conic = VS_Conic[Index];
	Output.Conic = float3(-0.5 * Conic.x, -Conic.y, -0.5 * Conic.z);

    float4 QuadScale = VS_SSScale[Index];
    float2 ScreenSpacePos = VS_SSPositions[Index];
    float2 Vertex = Quad[GlobalVertexId];

	Output.Mean = float2((float2(ScreenSpacePos.x, -ScreenSpacePos.y) + 1) * 0.5f * PrimaryView.ViewSizeAndInvSize.xy);
    Output.Position = float4(ScreenSpacePos.xy + (Vertex.x * QuadScale.zw + Vertex.y * QuadScale.xy), 0, 1);

    // Must invert bits for unlit splats as they are sorted in opposite order
	float SceneDepth = inverse_order_preserving_float_map(VS_Depth[InstanceID]);
	// Multiply by 100 to convert to centimetres
	Output.DeviceZ = ConvertToDeviceZ(100.0f * SceneDepth);

#if ENABLE_RELIGHTING
	Output.MR = UnpackMetallicRoughness(VS_MetallicRoughness[Index]);
	Output.Normal = UnpackNormal(VS_Normal[Index]);
	Output.Velocity = UnpackVelocity(VS_SSVelocity[Index]);
#else
	float4 TranslatedWorldPos = mul(float4(ScreenSpacePos, Output.DeviceZ, 1.0f), PrimaryView.ClipToTranslatedWorld);
	Output.TranslatedWorldPosition = TranslatedWorldPos.xyz / TranslatedWorldPos.w;
#endif

    return Output;
}

struct FRTOut
{
    float4 Color : SV_Target0;
    
#if ENABLE_RELIGHTING
    float4 Normal : SV_Target1;
	float4 DeviceZMetallicRoughness : SV_Target2;
	float4 Velocity : SV_Target3;
#else
    float4 Velocity : SV_Target1;
#endif
	float DeviceZ : SV_Depth;
};
 
// The residual sky along a world direction at a lobe's roughness, at the mip
// UE's captures read it (as GSSkyRadiance).
float3 GSPixelSky(float3 World, float Roughness)
{
	const float Mip = clamp(SkyResidualMips - 1.0f - (1.0f - 1.2f * log2(max(Roughness, 0.001f))), 0.0f, SkyResidualMips - 1.0f);
	return TextureCubeSampleLevel(SkyResidual, SkyCubemapSampler, World, Mip).rgb * View.SkyLightColor.rgb;
}

// athenea's splat_blend: a sharp lobe read at this pixel, along the mirror it
// turns to a step from the centre's.
float3 GSSharpSky(uint4 A, uint4 B, float2 Offset)
{
	const float2 At = float2(f16tof32(A.x), f16tof32(A.x >> 16))
		+ float2(f16tof32(A.y), f16tof32(A.y >> 16)) * Offset.x
		+ float2(f16tof32(A.z), f16tof32(A.z >> 16)) * Offset.y;
	const float3 Mirror = GSOctDecode(saturate(At));
	const float CoatW = f16tof32(A.w), CoatR = f16tof32(A.w >> 16);
	const float3 PolishW = float3(f16tof32(B.x), f16tof32(B.x >> 16), f16tof32(B.y));
	const float PolishR = f16tof32(B.y >> 16);
	float3 Sky = 0;
	if (CoatW > 0.0f)
	{
		Sky += CoatW * GSPixelSky(Mirror, CoatR);
	}
	if (any(PolishW > 0.0f))
	{
		Sky += PolishW * GSPixelSky(Mirror, PolishR);
	}
	const float4 Sun = SunWorld[0];
	if (Sun.w > 0.0f)
	{
		const float3 PolishSun = float3(f16tof32(B.z), f16tof32(B.z >> 16), f16tof32(B.w));
		const float CoatSun = f16tof32(B.w >> 16);
		Sky += SunWorld[1].rgb * (PolishSun * GSSunReflectPdf(Mirror, Sun.xyz, PolishR, Sun.w)
			+ CoatSun * GSSunReflectPdf(Mirror, Sun.xyz, CoatR, Sun.w));
	}
	return Sky;
}

FRTOut GSSplatting_PS(FOutVertex Input)
{
	FRTOut Output;

    float2 DistanceFromMean = (Input.Mean.xy - Input.Position.xy);

    float Power = dot(Input.Conic.xzy, float3(DistanceFromMean * DistanceFromMean, DistanceFromMean.x * DistanceFromMean.y));
    // athenea: an opacity D over 1 is Spark's harder kernel (athenea's
    // falloffAlpha): A = exp((D^2 - 1)/e) coincident gaussians, 1 - (1 - g)^A,
    // a flat top and the gaussian's shoulder past it -- what a .athc's merged
    // groups are drawn with. Drawn as D times a gaussian, its alpha passed 1:
    // over-bright rims and the splats behind it darkened.
    const float Gauss = exp(Power);
    // athenea: a medium's gaussian (a negative opacity, its optical depth
    // through the centre): 1 - exp(-tau) of its ray's depth.
    float Alpha = Input.Opacity < 0.0f ? 1.0f - exp(Input.Opacity * Gauss)
        : Input.Opacity > 1.0f
        ? 1.0f - pow(max(1.0f - Gauss, 0.0f), exp((Input.Opacity * Input.Opacity - 1.0f) * 0.36787944f))
        : Gauss * Input.Opacity;

	float3 Shade = Input.Color;
	if (any(Input.SharpA != 0u))
	{
		Shade = max(Shade + GSSharpSky(Input.SharpA, Input.SharpB, -DistanceFromMean), 0.0f);
	}
	Output.Color = float4(Shade, 1) * Alpha;
#if !ENABLE_RELIGHTING
	// athenea: an unlit splat's colour is scene light, so it takes the view's
	// pre-exposure as everything else in SceneColor does.
	Output.Color.rgb *= PrimaryView.PreExposure;
#endif

#if ENABLE_RELIGHTING
    Output.Normal = float4(Input.Normal, 1) * Alpha;
	Output.DeviceZMetallicRoughness = float4(Input.DeviceZ, Input.MR, 1) * Alpha;

	Output.Velocity = float4(Input.Velocity, 1) * Alpha;

#else
	// Must write out velocity for TAA/TSR for unlit splats, as they do not write depth information where velocity can be reconstructed from
	float2 ClipPos = ((Input.Mean.xy * PrimaryView.ViewSizeAndInvSize.zw * 2.0f) - 1.0f) * float2(1.0f, -1.0f);

	// Calculate previous clip position from world position
	float3 PrevTranslatedWorldPos = Input.TranslatedWorldPosition + DFSubtractDemote(PrimaryView.PrevPreViewTranslation, PrimaryView.PreViewTranslation);
	float4 PrevClipPos = mul(float4(PrevTranslatedWorldPos, 1.0f), PrimaryView.PrevTranslatedWorldToClip);
	PrevClipPos.xyz /= PrevClipPos.w;

	// Remove jitter
	ClipPos -= PrimaryView.TemporalAAJitter.xy;
	PrevClipPos.xy -= PrimaryView.TemporalAAJitter.zw;

	float3 Velocity = float3(ClipPos - PrevClipPos.xy, Input.DeviceZ - PrevClipPos.z);

	Output.Velocity = EncodeVelocityToTexture(Velocity);

	// For unlit splats, only used to test against scene depth and not written to depth buffer
#endif

	Output.DeviceZ = Input.DeviceZ;

    return Output;
}
