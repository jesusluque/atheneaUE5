#include "/Engine/Private/Common.ush"
#include "/Engine/Private/ComputeShaderUtils.ush"

#include "/Engine/Generated/GeneratedUniformBuffers.ush"
#include "GSSplatData.ush"

#ifndef ENABLE_RELIGHTING
#define ENABLE_RELIGHTING false
#endif

#ifndef THREADGROUP_SIZE_1D
#define THREADGROUP_SIZE_1D 1
#endif


Buffer<uint> IndexCountBuffer;
Buffer<uint> IndexBuffer;

// Output buffers
RWStructuredBuffer<float3> RWPositions;
RWStructuredBuffer<float3> RWScales;
RWStructuredBuffer<float4> RWOrientations;
RWStructuredBuffer<float4> RWSHAndOpacities;

RWStructuredBuffer<float3> RWNormals;
RWStructuredBuffer<float2> RWMetallicRoughness;


[numthreads(THREADGROUP_SIZE_1D, 1, 1)]
void GSExportPassCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	uint NumIndices = IndexCountBuffer[0];
	uint Index = DispatchThreadId.x;

	if (Index < NumIndices)
	{
		uint SplatIndex = IndexBuffer[Index];

		// Copy data into output buffers
		RWPositions[Index] = GSPos(SplatIndex);
		RWScales[Index] = GSScl(SplatIndex);
		RWOrientations[Index] = GSRot(SplatIndex);
		RWSHAndOpacities[Index] = GSShOp(SplatIndex);

		RWNormals[Index] = GSResources.Normals[SplatIndex];
		RWMetallicRoughness[Index] = GSResources.MetallicRoughness[SplatIndex];
	}
}
